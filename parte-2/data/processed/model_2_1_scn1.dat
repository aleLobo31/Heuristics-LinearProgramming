# Problema de asignación de buses a slots del taller

data;

set BUSES := Bus1 Bus2 Bus3 Bus4;
set SLOTS := Slot1 Slot2 Slot3;

param COSTE_ASIGNACION := 1.0;
param COSTE_OPORTUNIDAD := 5.0;

param DISTANCIAS :=
    Bus1  40.0
    Bus2  30.0
    Bus3  20.0
    Bus4  10.0;

param PASAJEROS :=
    Bus1  10.0
    Bus2  20.0
    Bus3  30.0
    Bus4  40.0;

end;
