# ============================================================
# CASO SIMPLE: 3 buses, 2 talleres, 2 franjas
# ============================================================
# Objetivo: Minimizar pasajeros afectados por ir a misma franja
#           en talleres diferentes

data;

# Definición de conjuntos
set BUSES := B1 B2 B3;
set TALLERES := T1 T2;
set SLOTS := S1 S2;

# Matriz de pasajeros compartidos (simétrica)
# Interpretación:
# - B1 y B2 comparten 50 pasajeros (¡MUCHOS!)
# - B1 y B3 comparten 10 pasajeros (pocos)
# - B2 y B3 comparten 0 pasajeros (ninguno)
param PASAJEROS_COMPARTIDOS:
      B1  B2  B3 :=
  B1   0  50  10
  B2  50   0  10
  B3  10  10   0;

# Disponibilidad de franjas en cada taller
# Todas las franjas están disponibles en ambos talleres
param DISPONIBILIDAD_SLOT:
      T1  T2 :=
  S1   1   1
  S2   1   1;

end;

# ============================================================
# ANÁLISIS DEL RESULTADO ESPERADO:
# ============================================================
#
# SOLUCIÓN ÓPTIMA:
# ----------------
# B1 → T1, S1
# B2 → T2, S1  ← B1 y B2 en misma franja S1 pero talleres diferentes
# B3 → T1, S2  (o cualquier otro slot disponible)
#
# CÁLCULO DE LA PENALIZACIÓN:
# ---------------------------
# Pares que coinciden en misma franja pero talleres diferentes:
# - (B1, B2): Ambos en S1 → Penalización = 50 pasajeros
# - (B1, B3): En franjas diferentes → Penalización = 0
# - (B2, B3): En franjas diferentes → Penalización = 0
#
# FUNCIÓN OBJETIVO ÓPTIMA = 50
#
# NOTA: No se puede hacer mejor porque:
# - Solo hay 2 franjas disponibles
# - Tenemos 3 buses que asignar
# - Por el principio del palomar, AL MENOS 2 buses irán
#   a la misma franja
# - Lo mejor es que coincidan B1 y B3 (10 pasajeros) o
#   B2 y B3 (0 pasajeros)
#
# MEJOR SOLUCIÓN ALTERNATIVA:
# ---------------------------
# B1 → T1, S1
# B2 → T1, S2  (o T2, S2)
# B3 → T2, S1  ← B1 y B3 en misma franja pero talleres diferentes
#
# Penalización = 10 pasajeros (mucho mejor!)
#
# FUNCIÓN OBJETIVO ÓPTIMA REAL = 10
# ============================================================